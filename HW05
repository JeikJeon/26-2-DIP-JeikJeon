        "## 3. 적절한 임계값을 찾아 thresholding을 통해 binary mask를 생성하기"
      ],
      "metadata": {
        "id": "t6BYa-NMPG66"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "plt.hist(f_denoised.ravel(), bins=256, range=(0,256), color='gray')\n",
        "plt.xlabel('Pixel Intensity')\n",
        "plt.ylabel('Frequency')\n",
        "plt.grid(True, linestyle='--', alpha=0.5)\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 449
        },
        "id": "OQblyVM7O6bk",
        "outputId": "179501ba-0dcf-4354-eeb8-051791449236"
