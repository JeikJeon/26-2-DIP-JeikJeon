          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "th_val = 128\n",
        "f_mask = f_denoised < th_val\n",
        "\n",
        "# Connected Component 구하기\n",
        "temp_labels, temp_nums = nd.label(f_mask)\n",
        "\n",
        "# 영상 테두리에 연결된 Component 찾기\n",
        "border_labels = np.unique(np.concatenate([\n",
        "    temp_labels[0, :],\n",
        "    temp_labels[-1, :],\n",
        "    temp_labels[:, 0],\n",
        "    temp_labels[:, -1]\n",
        "]))\n",
        "\n",
        "# 배경 라벨 0 제외\n",
        "border_labels = border_labels[border_labels != 0]\n",
        "\n",
        "# 테두리에 연결된 노이즈 제거\n",
        "f_mask = f_mask & ~np.isin(temp_labels, border_labels)\n",
        "\n",
        "# 결과 출력\n",
        "plt.imshow(f_mask, cmap='gray')\n",
        "plt.axis('off')\n",
        "plt.show()"
      ],
